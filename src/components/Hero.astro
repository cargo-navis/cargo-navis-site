---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { getHome, demoHref, shape } from '../data/home';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { hero } = getHome(locale);
---

<header class="relative z-[6] overflow-clip pb-[100px] pt-[188px] max-lg:pb-20 max-lg:pt-[170px] max-md:pb-[60px] max-md:pt-40 max-[479px]:pt-[140px]">
  <!-- decorative blur blobs -->
  <div class="pointer-events-none absolute right-[18%] top-[13px] -z-10 h-[537px] w-[558px] rounded-full bg-brand blur-[250px]"></div>
  <div class="pointer-events-none absolute left-10 top-0 -z-10 h-[537px] w-[558px] rounded-full bg-brand/15 blur-[250px]"></div>

  <div class="mx-auto w-full max-w-[1170px] px-4">
    <div class="grid grid-cols-[1.1fr_1fr] items-center gap-[60px] min-[1280px]:gap-[90px] min-[1440px]:grid-cols-2 min-[1440px]:gap-9 max-lg:grid-cols-1 max-lg:gap-10">
      <div class="lg:-mt-9 max-lg:text-center">
        <h1
          data-reveal
          class="mb-6 text-[clamp(2.625rem,2rem+2.6667vw,4rem)] font-bold leading-[1.18]"
        >
          {hero.heading}
        </h1>
        <p data-reveal class="mb-8" style="--reveal-delay:80ms">{hero.subtitle}</p>
        <div data-reveal class="flex max-lg:justify-center" style="--reveal-delay:160ms">
          <Button label={t('cta.demo')} href={localizePath(demoHref, locale)} />
        </div>
      </div>

      <!-- Screenshots are unreadable at phone widths; hidden below md.
           Astro emits loading="lazy", so display:none also skips the download.
           On tablet the block stacks below the copy: lay all four out in one
           full-width row, each cropped to a uniform 190px so the strip reads
           as a single band and stays short. Top-anchored to keep the headers. -->
      <div class="grid grid-cols-2 gap-5 max-lg:flex max-lg:w-full max-lg:items-center max-lg:justify-center max-md:hidden">
        <div data-reveal="scale-80" class="grid grid-flow-row gap-4 max-lg:min-w-0 max-lg:flex-1 max-lg:grid-flow-col">
          <Image src={hero.images.two[0].src} alt={hero.images.two[0].alt} class="rounded-[13px] max-lg:h-[190px] max-lg:w-full max-lg:object-cover max-lg:object-top" />
          <Image src={hero.images.two[1].src} alt={hero.images.two[1].alt} class="rounded-[13px] max-lg:h-[190px] max-lg:w-full max-lg:object-cover max-lg:object-top" />
        </div>
        <div data-reveal="scale-80" class="grid grid-flow-row gap-5 self-center max-lg:min-w-0 max-lg:flex-1 max-lg:grid-flow-col" style="--reveal-delay:120ms">
          <Image src={hero.images.three.src} alt={hero.images.three.alt} class="w-[55%] justify-self-center rounded-xl max-lg:h-[190px] max-lg:w-full max-lg:object-cover max-lg:object-top" />
          <Image src={hero.images.four.src} alt={hero.images.four.alt} class="rounded-2xl max-lg:h-[190px] max-lg:w-full max-lg:object-cover max-lg:object-top" />
        </div>
      </div>
    </div>
  </div>

  <!-- decorative graph shape -->
  <div class="pointer-events-none absolute right-0 top-[110px] -z-10 flex max-w-[430px] justify-end min-[1280px]:max-w-[545px] min-[1440px]:max-w-[666px]">
    <Image src={shape} alt="Shape Image" />
  </div>
</header>
