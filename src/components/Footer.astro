---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { getHome, demoHref, logomark } from '../data/home';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { footer } = getHome(locale);
const homeHref = localizePath('/', locale);
const copyright = `© ${new Date().getFullYear()} Cargo Navis. ${t('footer.rights')}`;
---

<footer class="pt-[60px] pb-[30px] max-md:pt-10">
  <div class="mx-auto w-full max-w-[1170px] px-4">
    <div class="mb-[50px] flex justify-between gap-[130px] min-[1280px]:mb-[60px] max-lg:flex-wrap max-lg:gap-[60px] max-[479px]:gap-10">
      <!-- logo column -->
      <div data-reveal class="max-w-[310px] max-lg:max-w-[600px]">
        <a href={homeHref} class="mb-6 inline-flex items-center">
          <Image src={logomark} alt="Logo" class="w-[42px]" />
        </a>
        <p class="mb-6">{t('footer.tagline')}</p>
        <Button label={t('cta.demo')} href={localizePath(demoHref, locale)} />
      </div>

      <!-- menu columns -->
      <div class="flex max-w-[700px] justify-between gap-20 max-lg:gap-[60px] max-md:flex-wrap max-md:gap-[30px]">
        {
          footer.menus.map((menu) => (
            <div data-reveal class="max-w-[154px]">
              <div class="mb-4 font-semibold leading-[1.55]">{t(menu.titleKey)}</div>
              <div class="flex flex-col gap-3">
                {menu.links.map((l) => (
                  <a
                    href={localizePath(l.href, locale)}
                    class="text-base leading-[1.75] transition-colors duration-300 hover:text-brand"
                  >
                    {t(l.key)}
                  </a>
                ))}
              </div>
            </div>
          ))
        }

        <!-- contact column -->
        <div data-reveal class="max-w-[230px] max-[479px]:max-w-none">
          <div class="mb-4 font-semibold leading-[1.55]">{t('footer.contact')}</div>
          <div class="flex flex-col gap-3">
            <a href={footer.contact.email.href} class="text-base leading-[1.75] transition-colors duration-300 hover:text-brand">
              {footer.contact.email.label}
            </a>
            <p class="max-w-[229px] text-base leading-[1.75] max-[479px]:max-w-none" set:html={footer.contact.address} />
          </div>
        </div>
      </div>
    </div>

    <div data-reveal class="flex justify-between gap-[30px] max-[479px]:flex-wrap">
      <div class="max-[479px]:w-full">{copyright}</div>
    </div>
  </div>
</footer>
