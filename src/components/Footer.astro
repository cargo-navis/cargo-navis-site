---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { footer, logomark } from '../data/home';
---

<footer class="pb-[30px]">
  <div class="mx-auto w-full max-w-[1170px] px-4">
    <div class="mb-[50px] flex justify-between gap-[130px] min-[1280px]:mb-[60px] max-lg:flex-wrap max-lg:gap-[60px] max-[479px]:gap-10">
      <!-- logo column -->
      <div data-reveal class="max-w-[310px] max-lg:max-w-[600px]">
        <a href="/" class="mb-6 inline-flex items-center">
          <Image src={logomark} alt="Logo" class="w-[42px]" />
        </a>
        <p class="mb-6">{footer.tagline}</p>
        <Button label={footer.cta.label} href={footer.cta.href} />
      </div>

      <!-- menu columns -->
      <div class="flex max-w-[700px] justify-between gap-20 max-lg:gap-[60px] max-md:flex-wrap max-md:gap-[30px]">
        {
          footer.menus.map((menu) => (
            <div data-reveal class="max-w-[154px]">
              <div class="mb-4 font-semibold leading-[1.55]">{menu.title}</div>
              <div class="flex flex-col gap-3">
                {menu.links.map((l) => (
                  <a
                    href={l.href}
                    class="text-base leading-[1.75] transition-colors duration-300 hover:text-brand"
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }

        <!-- contact column -->
        <div data-reveal class="max-w-[230px] max-[479px]:max-w-none">
          <div class="mb-4 font-semibold leading-[1.55]">{footer.contact.title}</div>
          <div class="flex flex-col gap-3">
            <a href={footer.contact.phone.href} class="text-base leading-[1.75] transition-colors duration-300 hover:text-brand">
              {footer.contact.phone.label}
            </a>
            <a href={footer.contact.email.href} class="text-base leading-[1.75] transition-colors duration-300 hover:text-brand">
              {footer.contact.email.label}
            </a>
            <p class="max-w-[229px] text-base leading-[1.75] max-[479px]:max-w-none" set:html={footer.contact.address} />
          </div>
        </div>
      </div>
    </div>

    <div data-reveal class="flex justify-between gap-[30px] max-[479px]:flex-wrap">
      <div class="max-[479px]:w-full">{footer.copyright}</div>
    </div>
  </div>
</footer>
