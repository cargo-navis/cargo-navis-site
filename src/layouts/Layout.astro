---
import '../styles/global.css';
import { SITE, META, LEGAL, OG_IMAGE, ORG_ID } from '../consts';
import { getLocale, stripLocale } from '../i18n/utils';
import { defaultLocale, locales } from '../i18n/ui';
import Analytics from '../components/Analytics.astro';
// Heading font (Sora 700) for the LCP <h1>: preloaded so it does not wait for the CSS to be parsed. Same files the
// @fontsource CSS in global.css references, so Vite emits one hashed copy. latin-ext carries č ć š ž đ.
import soraLatin from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';
import soraLatinExt from '@fontsource/sora/files/sora-latin-ext-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Path WITHOUT locale prefix, e.g. "/" or "/features". Used for canonical + hreflang. */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (the Organization one is always emitted). */
  jsonLd?: Record<string, unknown>[];
}

const locale = getLocale(Astro.url);
const meta = META[locale];
const { title = meta.title, description = meta.description, path, ogImage, noindex = false, jsonLd = [] } = Astro.props;
const fontPreloads = locale === 'hr' ? [soraLatin, soraLatinExt] : [soraLatin];

// Derive the locale-agnostic path from the current URL when not passed explicitly.
const rawPath = path ?? stripLocale(Astro.url.pathname);
const cleanPath = rawPath === '' ? '/' : rawPath;

const hrefFor = (loc: string) => {
  const prefix = loc === defaultLocale ? '' : `/${loc}`;
  const p = cleanPath === '/' ? '' : cleanPath;
  return new URL(`${prefix}${p || '/'}`, SITE.url).href;
};

const canonical = hrefFor(locale);
const ogImageUrl = new URL(ogImage ?? OG_IMAGE[locale].src, SITE.url).href;
const ogImageAlt = OG_IMAGE[locale].alt;
const htmlLang = locale === 'hr' ? 'hr-HR' : 'en';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: SITE.name,
  url: SITE.url,
  sameAs: SITE.profiles,
  logo: new URL('/android-chrome-512x512.png', SITE.url).href,
  email: SITE.contactEmail,
  legalName: LEGAL.companyName,
  vatID: `HR${LEGAL.oib}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Županjska ulica 21',
    postalCode: '10000',
    addressLocality: 'Zagreb',
    addressCountry: 'HR',
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Phone browser bar in the hero's petrol, so it blends with the top of the page. */}
    <meta name="theme-color" content="#0b5560" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* hreflang alternates — skipped on noindex pages (e.g. 404), which have no
        per-locale twin to point at. */}
    {!noindex && locales.map((loc) => <link rel="alternate" hreflang={loc} href={hrefFor(loc)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={hrefFor(defaultLocale)} />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'hr' ? 'hr_HR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'hr' ? 'en_US' : 'hr_HR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Icons */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/android-chrome-512x512.png" />

    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <slot />

    <script>
      // Reveal [data-reveal] elements as they enter the viewport.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-revealed');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
    <Analytics />
  </body>
</html>
