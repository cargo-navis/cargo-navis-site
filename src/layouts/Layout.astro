---
import '../styles/global.css';
import { SITE, META, LEGAL } from '../consts';
import { getLocale, stripLocale } from '../i18n/utils';
import { defaultLocale, locales } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Path WITHOUT locale prefix, e.g. "/" or "/features". Used for canonical + hreflang. */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
}

const locale = getLocale(Astro.url);
const meta = META[locale];
const { title = meta.title, description = meta.description, path, ogImage, noindex = false } = Astro.props;

// Derive the locale-agnostic path from the current URL when not passed explicitly.
const rawPath = path ?? stripLocale(Astro.url.pathname);
const cleanPath = rawPath === '' ? '/' : rawPath;

const hrefFor = (loc: string) => {
  const prefix = loc === defaultLocale ? '' : `/${loc}`;
  const p = cleanPath === '/' ? '' : cleanPath;
  return new URL(`${prefix}${p || '/'}`, SITE.url).href;
};

const canonical = hrefFor(locale);
const ogImageUrl = new URL(ogImage ?? SITE.ogImage, SITE.url).href;
const htmlLang = locale === 'hr' ? 'hr-HR' : 'en';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/android-chrome-512x512.png', SITE.url).href,
  email: SITE.contactEmail,
  legalName: LEGAL.companyName,
  vatID: `HR${LEGAL.oib}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Županjska ulica 21',
    postalCode: '10000',
    addressLocality: 'Zagreb',
    addressCountry: 'HR',
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* hreflang alternates — skipped on noindex pages (e.g. 404), which have no
        per-locale twin to point at. */}
    {!noindex && locales.map((loc) => <link rel="alternate" hreflang={loc} href={hrefFor(loc)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={hrefFor(defaultLocale)} />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'hr' ? 'hr_HR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'hr' ? 'en_US' : 'hr_HR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Icons */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/android-chrome-512x512.png" />

    {/* Preload primary font weight */}
    <link
      rel="preload"
      href="/fonts/dmsans-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      // Reveal [data-reveal] elements as they enter the viewport.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-revealed');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
