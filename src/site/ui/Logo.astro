---
// Same mark as the app's sidebar / login: logomark on a white tile + „CargoNavis” in Sora.
import { Image } from 'astro:assets';
import logomark from '../../assets/logos/logomark.webp';
import { homeHref } from '../locale';

interface Props {
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: klass } = Astro.props;
---

<a href={homeHref(Astro.url)} aria-label="Cargo Navis" class:list={['flex items-center gap-2.5', klass]}>
  <span
    class:list={[
      'flex size-9 shrink-0 items-center justify-center rounded-lg bg-white',
      !inverted && 'border border-border',
    ]}
  >
    <Image src={logomark} alt="" class="size-6.5 object-contain" />
  </span>
  <span class:list={['font-heading text-[17px] font-bold tracking-tight', inverted ? 'text-white' : 'text-foreground']}>
    CargoNavis
  </span>
</a>
