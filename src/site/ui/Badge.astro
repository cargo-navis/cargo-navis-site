---
// The app's Badge (KAN-55, /overlays/badge): tone × look; pill, sentence case. Colour = meaning, never alone.
import Icon, { type IconName } from './Icon.astro';

type Tone = 'neutral' | 'brand' | 'info' | 'success' | 'warning' | 'danger' | 'category';
interface Props {
  tone?: Tone;
  look?: 'soft' | 'outline' | 'solid' | 'dot';
  icon?: IconName;
  class?: string;
}
const { tone = 'neutral', look = 'soft', icon, class: klass } = Astro.props;

const SOFT: Record<Tone, string> = {
  neutral: 'border-border bg-muted text-foreground/80',
  brand: 'border-teal-200 bg-teal-50 text-teal-800',
  info: 'border-blue-300 bg-blue-50 text-blue-700',
  success: 'border-green-300 bg-green-50 text-green-700',
  warning: 'border-amber-300 bg-amber-50 text-amber-800',
  danger: 'border-red-300 bg-red-50 text-red-700',
  category: 'border-agency-300 bg-agency-50 text-agency-700',
};
const OUTLINE: Record<Tone, string> = {
  neutral: 'border-border text-foreground/80',
  brand: 'border-teal-300 text-teal-800',
  info: 'border-blue-300 text-blue-700',
  success: 'border-green-300 text-green-700',
  warning: 'border-amber-400 text-amber-800',
  danger: 'border-red-300 text-red-700',
  category: 'border-agency-300 text-agency-700',
};
const SOLID: Record<Tone, string> = {
  neutral: 'border-transparent bg-foreground text-background',
  brand: 'border-transparent bg-primary text-primary-foreground',
  info: 'border-transparent bg-blue-600 text-white',
  success: 'border-transparent bg-green-700 text-white',
  warning: 'border-transparent bg-amber-500 text-amber-950',
  danger: 'border-transparent bg-red-600 text-white',
  category: 'border-transparent bg-agency-500 text-white',
};
const DOT: Record<Tone, string> = {
  neutral: 'bg-neutral-400',
  brand: 'bg-teal-500',
  info: 'bg-blue-500',
  success: 'bg-green-500',
  warning: 'bg-amber-500',
  danger: 'bg-red-500',
  category: 'bg-agency-500',
};
const cls = look === 'soft' ? SOFT[tone] : look === 'outline' || look === 'dot' ? OUTLINE[tone] : SOLID[tone];
---

<span
  class:list={[
    'inline-flex h-5 shrink-0 items-center gap-1 rounded-full border px-2 text-[11.5px] leading-none font-medium whitespace-nowrap',
    look === 'dot' ? 'border-border text-foreground/80' : cls,
    klass,
  ]}
>
  {look === 'dot' && <span class:list={['size-1.5 rounded-full', DOT[tone]]} />}
  {icon && <Icon name={icon} size={12} />}
  <slot />
</span>
