---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../site/sections/SiteNav.astro';
import SiteFooter from '../site/sections/SiteFooter.astro';
import Button from '../site/ui/Button.astro';
import RoutePattern from '../site/ui/RoutePattern.astro';
import { DEMO_PATH } from '../consts';

// A single static 404.html is served for every unmatched path, including the /en/ tree, so the page ships both
// languages and reveals the one matching the URL (see the inline script below). Croatian shows when JS is unavailable.
// Nav and footer render in Croatian (the page has no locale in its own URL).
const copy = [
  {
    lang: 'hr',
    heading: 'Stranica nije pronađena',
    text: 'Stranica koju tražiš ne postoji ili je premještena. Vrati se na početnu ili dogovori demo.',
    home: 'Natrag na početnu',
    demo: 'Dogovori demo',
  },
  {
    lang: 'en',
    heading: 'Page not found',
    text: 'The page you are looking for does not exist or has moved. Head back home, or book a demo.',
    home: 'Back to home',
    demo: 'Book a demo',
  },
];
---

<Layout path="/404" noindex title="404 - Cargo Navis" description="Stranica nije pronađena / Page not found.">
  {/* Runs before the copy below is parsed, so only one language ever paints. */}
  <script is:inline>
    if (location.pathname === '/en' || location.pathname.indexOf('/en/') === 0) {
      document.documentElement.dataset.pageLang = 'en';
      document.documentElement.lang = 'en';
    }
  </script>

  <div class="relative overflow-hidden bg-primary text-white">
    <RoutePattern class="pointer-events-none absolute inset-0 size-full text-teal-300 opacity-50" />
    <SiteNav tone="dark" />
    <main class="relative mx-auto max-w-[760px] px-6 pt-20 pb-32 text-center max-md:pt-12 max-md:pb-24">
      <div
        class="font-heading text-[clamp(5rem,3rem+10vw,9rem)] leading-none font-bold tracking-tight text-teal-300"
        aria-hidden="true"
      >
        404
      </div>
      {
        copy.map((c) => (
          <div data-404-lang={c.lang} lang={c.lang} class="mt-8">
            <h1 class="text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] leading-[1.15]">{c.heading}</h1>
            <p class="mx-auto mt-4 max-w-[520px] text-[17px] text-white/80">{c.text}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              <Button href={c.lang === 'hr' ? '/' : '/en/'} variant="inverse">
                {c.home}
              </Button>
              <Button href={c.lang === 'hr' ? DEMO_PATH : `/en${DEMO_PATH}`} variant="inverse-outline">
                {c.demo}
              </Button>
            </div>
          </div>
        ))
      }
    </main>
  </div>

  <SiteFooter />
</Layout>
