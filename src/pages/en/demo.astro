---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import DemoSection from '../../components/DemoSection.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import Testimonials from '../../components/Testimonials.astro';
import Footer from '../../components/Footer.astro';
import { demo } from '../../data/demo';
import { getLocale } from '../../i18n/utils';

const copy = demo[getLocale(Astro.url)];
---

<Layout path="/demo" title={copy.metaTitle} description={copy.metaDescription}>
  <Navbar />
  <DemoSection />
  <main class="main-wrapper">
    <LogoMarquee />
    <Testimonials />
  </main>
  <Footer />
</Layout>
