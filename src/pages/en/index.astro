---
import Layout from '../../layouts/Layout.astro';
import { getLocale, useTranslations, localizePath } from '../../i18n/utils';
import { DEMO_PATH } from '../../consts';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<Layout path="/">
  <main class="mx-auto max-w-[var(--container-site)] px-6 py-24">
    <h1 class="text-4xl font-black text-brand">Cargo Navis</h1>
    <p class="mt-4 text-brand-secondary">
      {/* Placeholder — full 1:1 rebuild lands in Step 5. */}
      Scaffold layout active. Section rebuild lands in Step 5.
    </p>
    <a
      href={localizePath(DEMO_PATH, locale)}
      class="mt-8 inline-block rounded-lg bg-brand px-6 py-3 font-semibold text-white"
    >
      {t('cta.demo')}
    </a>
  </main>
</Layout>
