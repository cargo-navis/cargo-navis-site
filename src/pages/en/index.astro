---
// Mirror of src/pages/index.astro; the components read the locale from the URL.
import Layout from '../../layouts/Layout.astro';
import Hero from '../../site/sections/AHero.astro';
import LogoStrip from '../../site/sections/LogoStrip.astro';
import DaySteps from '../../site/sections/DaySteps.astro';
import MoreDark from '../../site/sections/MoreDark.astro';
import Testimonials from '../../site/sections/quotes/QuotesProofCarousel.astro';
import Faq from '../../site/sections/Faq.astro';
import CtaBooking from '../../site/sections/CtaBooking.astro';
import SiteFooter from '../../site/sections/SiteFooter.astro';
import { homeJsonLd } from '../../site/jsonld';
---

<Layout path="/" jsonLd={homeJsonLd(Astro.url)}>
  <Hero />
  <main>
    <LogoStrip size="lg" class="border-b border-border pt-16" />
    <DaySteps phoneLive />
    <MoreDark />
    <Testimonials />
    <Faq />
    <CtaBooking />
  </main>
  <SiteFooter />
</Layout>
